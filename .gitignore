.venv/
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
# Шаблон ".env" совпадал только с файлом ровно такого имени: копия вроде
# "andrewcoffe.env" или ".env.backup" утекла бы в репозиторий вместе с токеном.
.env
*.env
.env.*
!.env.example
# Метка «перезапусти меня» между приложением и скриптом запуска — не код.
.restart
.nicegui/
backups/
logs/
*.pdf
tools/
.claude/
