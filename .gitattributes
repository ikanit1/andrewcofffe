# Скрипты для sh обязаны иметь перевод строки LF: при CRLF шебанг превращается
# в "#!/bin/sh\r", и запуск падает с «bad interpreter». На Windows git по
# умолчанию подставляет CRLF при выгрузке, поэтому оговариваем явно.
deploy/hooks/* text eol=lf

# Файл версии читают и скрипт-хук, и приложение — держим один вид переносов.
VERSION text eol=lf
